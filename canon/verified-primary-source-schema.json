{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://yellowbeast.dev/schemas/verified-primary-source/v1","type":"object","additionalProperties":false,"required":["id","source_ref","exact_title","source_type","creator","publisher","stable_locator","publication","directly_checked","transcript_assisted","verification_notes","review_history","locators"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"source_ref":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"exact_title":{"type":"string","minLength":1},"source_type":{"const":"official-video"},"creator":{"const":"Kane Pixels"},"publisher":{"const":"YouTube"},"stable_locator":{"type":"string","pattern":"^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"},"publication":{"type":"object","additionalProperties":false,"required":["utc_date","source_page_local_time"],"properties":{"utc_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"source_page_local_time":{"type":"string","minLength":1}}},"directly_checked":{"const":true},"transcript_assisted":{"type":"boolean"},"verification_notes":{"type":"string","minLength":1},"review_history":{"type":"array","minItems":1,"items":{"enum":["unreviewed","triaged","source-verified","claim-extracted","canon-reviewed","admitted","rejected","superseded","needs-context"]}},"locators":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","locator_type","start","end","description","verification_state"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"locator_type":{"enum":["video-timestamp","title-card","official-description"]},"start":{"type":"string","pattern":"^\\d{2}:\\d{2}:\\d{2}$"},"end":{"type":"string","pattern":"^\\d{2}:\\d{2}:\\d{2}$"},"description":{"type":"string","minLength":1},"verification_state":{"const":"directly-checked"}}}}}}
