{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://yellowbeast.dev/schemas/anomaly-observation/v1","type":"object","additionalProperties":false,"required":["id","source_refs","locator_refs","environment_ref","feature_ref","observer_refs","observation_type","spatial_scope","boundary_state","precondition","observed_change","postcondition","persistence","repeatability","visibility","measurement_state","uncertainties","canon_status","simulation_authority","review_state"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"source_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"locator_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"environment_ref":{"type":"string"},"feature_ref":{"type":"string"},"observer_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"observation_type":{"enum":["surface-discontinuity","pass-through-interaction","disappearance","partial-embedding","spatial-mismatch","inaccessible-visible-region","unexpected-connection","bounded-anomalous-region","environmental-transition","unresolved-anomaly"]},"spatial_scope":{"enum":["bounded-local","source-local","unresolved"]},"boundary_state":{"enum":["marked","visually-apparent","visually-unapparent","physically-probed","approximately-bounded","stable-during-observation","changed-during-observation","unresolved"]},"interaction_refs":{"type":"array","items":{"type":"string"}},"precondition":{"type":"string"},"observed_change":{"type":"string"},"postcondition":{"type":"string"},"persistence":{"enum":["observed-once","persisted-during-observation","persistence-unknown"]},"repeatability":{"enum":["observed-once","repeated-during-same-observation","observed-across-times","repeatability-unknown"]},"visibility":{"enum":["clear","partial","obscured","low-light","distant","degraded-recording","unresolved"]},"measurement_state":{"enum":["qualitative-probe","numeric-measurement","stated-measurement","derived-estimate","unresolved"]},"uncer