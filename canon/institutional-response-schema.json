{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yellow-beast-institutional-response-schema@v1",
  "title": "Yellow Beast institutional response worldpack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "worldpack_id", "initial_state", "response_rules", "follow_up_assignments"],
  "properties": {
    "version": { "const": "yellow-beast-institutional-worldpack@v1" },
    "worldpack_id": { "$ref": "#/$defs/id" },
    "initial_state": { "type": "object", "additionalProperties": { "type": "string" }, "minProperties": 9 },
    "response_rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "follow_up_assignments": { "type": "array", "items": { "$ref": "#/$defs/followUp" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "condition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["all"], "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["any"], "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } } },
        { "type": "object", "additionalProperties": false, "required": ["not"], "properties": { "not": { "$ref": "#/$defs/condition" } } },
        { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "input_type": { "type": "string" }, "purpose": { "type": "string" }, "state": { "type": "string" }, "outcome_family": { "type": "string" }, "quality": { "type": "string" }, "minimum_count": { "type": "integer", "minimum": 1 }, "has_fact": { "type": "string" } } }
      ]
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["id", "when", "decision", "delay", "public_response", "private_rationale", "state_changes"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "when": { "$ref": "#/$defs/condition" }, "decision": { "type": "string" }, "delay": { "type": "integer", "minimum": 0 }, "public_response": { "type": "string", "minLength": 1 }, "private_rationale": { "type": "string", "minLength": 1 }, "state_changes": { "type": "object", "additionalProperties": { "type": "string" } }, "follow_up_id": { "$ref": "#/$defs/id" } }
    },
    "followUp": {
      "type": "object", "additionalProperties": false, "required": ["id", "when", "display_name", "public_summary"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "when": { "$ref": "#/$defs/condition" }, "mission_id": { "$ref": "#/$defs/id" }, "display_name": { "type": "string", "minLength": 1 }, "public_summary": { "type": "string", "minLength": 1 }, "staffing_modifier": { "type": "object" }, "equipment_modifier": { "type": "object" } }
    }
  }
}
