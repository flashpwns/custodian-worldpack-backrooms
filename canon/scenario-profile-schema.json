{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://yellowbeast.dev/schemas/scenario-profile/v1","type":"object","additionalProperties":false,"required":["id","title","description","player_role_type","institutional_affiliation","starting_knowledge_profile","starting_permissions","starting_resource_profile","allowed_scenario_classes","information_access_policy","default_persistence","objective_model","failure_model","world_authority_policy","canon_policy","generation_policy","ui_metadata","review_state"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"title":{"type":"string"},"description":{"type":"string"},"player_role_type":{"type":"string"},"institutional_affiliation":{"enum":["async","civilian","none"]},"starting_knowledge_profile":{"type":"string"},"starting_permissions":{"type":"string"},"starting_resource_profile":{"type":"string"},"allowed_scenario_classes":{"type":"array","items":{"enum":["playable","tutorial","experimental"]}},"information_access_policy":{"enum":["observer-local","institutional-records-only","field-observation-only","civilian-minimal"]},"default_persistence":{"enum":["session-export","none"]},"objective_model":{"enum":["open-ended","task-based","survival","investigation","institutional-management"]},"failure_model":{"type":"array","items":{"enum":["none","mission-failure","incapacitation","death","loss-of-contact","resource-exhaustion","scenario-defined"]}},"world_authority_policy":{"const":"cannot-override-objective-world"},"canon_policy":{"const":"cannot-override-canon-authority"},"generation_policy":{"const":"no-procedural-world-generation"},"ui_metadata":{"type":"object"},"review_state":{"const":"admitted"}}}
