{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://yellowbeast.dev/schemas/transition-observation/v1","type":"object","additionalProperties":false,"required":["id","source_refs","locator_refs","origin_environment","destination_environment","observer_refs","transition_type","directionality","access_state","repeatability","return_observed","route_known","route_stability","preconditions","postconditions","visibility","uncertainties","canon_status","simulation_authority","review_state"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"source_refs":{"type":"array","items":{"type":"string"}},"locator_refs":{"type":"array","items":{"type":"string"}},"origin_environment":{"type":["string","null"]},"destination_environment":{"type":["string","null"]},"observer_refs":{"type":"array","items":{"type":"string"}},"transition_type":{"enum":["ordinary-traversal","threshold-crossing","anomalous-transition","return-traversal","recovery-route","re-entry","route-loss","inaccessible-continuation","unresolved-transition"]},"directionality":{"enum":["observed-one-way","return-observed","unknown"]},"access_state":{"enum":["institutionally-controlled","observer-accessible","unresolved"]},"repeatability":{"enum":["observed-once","unknown"]},"return_observed":{"type":"boolean"},"route_known":{"enum":["observer-local","institutional-assertion","unknown"]},"route_stability":{"enum":["observed-during-sequence","unknown"]},"preconditions":{"type":"array","items":{"type":"string"}},"postconditions":{"type":"array","items":{"type":"string"}},"visibility":{"enum":["clear","partial","unresolved"]},"uncertainties":{"type":"array","items":{"type":"string"}},"canon_status":{"enum":["observed","pack-original","officially-asserted","unknown"]},"simulation_authority":{"enum":["authoritative","scenario-optional","reference-only","prohibited"]},"review_state":{"enum":["admitted","needs-context","rejected"]}}}
