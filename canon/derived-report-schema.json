{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://yellowbeast.dev/schemas/derived-report/v1","type":"object","additionalProperties":false,"required":["id","author_kind","author_id","creation_ref","evidence_inputs","claims_asserted","confidence","review_state","intended_access","classification","contradictory_evidence_refs","omitted_evidence_refs","simulation_authority"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"author_kind":{"enum":["actor","institution"]},"author_id":{"type":"string","minLength":1},"creation_ref":{"type":"string","minLength":1},"evidence_inputs":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},"claims_asserted":{"type":"array","items":{"type":"string"},"uniqueItems":true},"confidence":{"enum":["high","medium","low","unresolved"]},"review_state":{"enum":["unreviewed","triaged","source-verified","claim-extracted","canon-reviewed","admitted","rejected","superseded","needs-context"]},"intended_access":{"type":"array","items":{"type":"string"},"uniqueItems":true},"classification":{"enum":["descriptive","interpretive","institutional-assertion","character-belief"]},"contradictory_evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"omitted_evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"simulation_authority":{"enum":["authoritative","interpretive-default","scenario-optional","experimental","reference-only","prohibited"]}}}
