{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://yellowbeast.dev/schemas/corpus-root/v1","type":"object","additionalProperties":false,"required":["id","platform","playlist_id","playlist_url","playlist_title","owning_channel","discovery_date","enumeration_status","video_count_discovered","unavailable_entry_count","review_state","notes","errors"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"platform":{"const":"youtube"},"playlist_id":{"type":"string"},"playlist_url":{"type":"string"},"playlist_title":{"type":["string","null"]},"owning_channel":{"type":["string","null"]},"discovery_date":{"type":"string"},"enumeration_status":{"enum":["completed","completed-with-unavailable-entries","failed"]},"video_count_discovered":{"type":"integer","minimum":0},"unavailable_entry_count":{"type":"integer","minimum":0},"review_state":{"const":"unreviewed"},"notes":{"type":"string"},"errors":{"type":"array"}}}
